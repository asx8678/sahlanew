[Unit]
Description=Sahla web application
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=exec
User=deploy
Group=deploy
WorkingDirectory=/opt/sahla/current
EnvironmentFile=/etc/sahla/app.env
ExecStart=/opt/sahla/current/bin/sahla start
ExecStop=/opt/sahla/current/bin/sahla stop
Restart=on-failure
RestartSec=3

# File descriptor limit for a busy Phoenix endpoint.
LimitNOFILE=65536

# Hardening: contain the process and limit blast radius if compromised.
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/sahla/shared

[Install]
WantedBy=multi-user.target
