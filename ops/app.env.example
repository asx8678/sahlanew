# /etc/sahla/app.env — production runtime environment for Sahla
#
# Copy this file to /etc/sahla/app.env, fill in the real values, then run:
#
#   sudo chown deploy:deploy /etc/sahla/app.env
#   sudo chmod 600 /etc/sahla/app.env
#
# The systemd unit loads this file via EnvironmentFile=.  Secrets never
# belong in CI logs, the release tarball, or version control.

# --- Core server --------------------------------------------------------------

# Fully-qualified public host (used for URL generation and CSP).
PHX_HOST=sahla.example.ma

# Port the release HTTP server binds to inside the host.
PORT=4000

# Set to "true" to start the HTTP server.  Omit or leave empty to boot
# the release in a mode that does not bind the endpoint (e.g. migrations).
PHX_SERVER=true

# --- Database -----------------------------------------------------------------

DATABASE_URL=ecto://sahla:__DB_PASSWORD__@127.0.0.1/sahla_prod
POOL_SIZE=15

# Uncomment only if the database is reachable over IPv6.
# ECTO_IPV6=true

# --- Cryptography -------------------------------------------------------------

# 64-byte secret for signing cookies and LiveView session tokens.
# Generate with:
#   mix phx.gen.secret
SECRET_KEY_BASE=__GENERATE_WITH_MIX_PHX_GEN_SECRET__

# Base64-encoded 32-byte AES-256-GCM key for PII encryption at rest.
# Generate with:
#   openssl rand -base64 32
CLOAK_KEY=__GENERATE_WITH_OPENSSL_RAND_BASE64_32__

# Separate secret for HMAC-based non-reversible lookups (e.g. recipient
# hashes in the notifications log).  Must differ from CLOAK_KEY.
# Generate with:
#   openssl rand -base64 32
HMAC_KEY=__GENERATE_WITH_OPENSSL_RAND_BASE64_32__

# --- SMS provider -------------------------------------------------------------

# Use "fake" to log messages locally, or "infobip" for live delivery.
SMS_PROVIDER=fake
SMS_API_KEY=__INFOBIP_API_KEY__
SMS_SENDER=__INFOBIP_SENDER_ID__

# --- Email provider -----------------------------------------------------------

POSTMARK_API_KEY=__POSTMARK_API_KEY__

# Optional: override the display name and From address at runtime.
MAIL_FROM_NAME=Sahla
MAIL_FROM_EMAIL=noreply@sahla.example.ma

# --- Anti-abuse / bot protection ----------------------------------------------

TURNSTILE_SITE_KEY=__TURNSTILE_SITE_KEY__
TURNSTILE_SECRET=__TURNSTILE_SECRET__

# --- File uploads -------------------------------------------------------------

# Private directory on a persistent volume (NOT inside the release directory).
UPLOADS_DIR=/opt/sahla/shared/uploads

# --- Observability ------------------------------------------------------------

SENTRY_DSN=__SENTRY_DSN__
PLAUSIBLE_DOMAIN=sahla.example.ma

# --- Clustering (optional) ----------------------------------------------------

# DNS cluster query for distributed Phoenix endpoints.  Leave empty or
# unset for a single-node deployment.
DNS_CLUSTER_QUERY=
